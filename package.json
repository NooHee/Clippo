{
  "name": "clippo",
  "version": "0.3.0",
  "description": "Clipboard history manager for macOS",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "concurrently -k \"vite\" \"npm run build:main && wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e/run.js",
    "bench:startup": "npm run build && scripts/perf/bench-startup.sh 7"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^25.0.0",
    "i18next": "^26.0.4",
    "lucide-react": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.clippo.app",
    "productName": "Clippo",
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Clippo uses System Events to detect the active app for ignored apps and as a fallback to paste."
      },
      "identity": null
    },
    "dmg": {
      "title": "Install Clippo",
      "background": null,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/mac/sign.js"
  }
}
